<!DOCTYPE html>
<html lang="uk">
<head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>Адмін-панель — NutriTrack</title>
    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
    <link href="https://fonts.googleapis.com/css2?family=Berkshire+Swash&family=Nunito:wght@400;600;700&display=swap" rel="stylesheet" />
    <style>
        * { box-sizing: border-box; }
        body {
            margin: 0;
            font-family: 'Nunito', -apple-system, BlinkMacSystemFont, sans-serif;
            background: #ffd2e1;
            color: #2b2328;
        }
        .header {
            background: #fff0f5;
            padding: 18px 28px;
            border-bottom: 1.5px solid #f4c6d7;
            display: flex;
            justify-content: space-between;
            align-items: center;
            flex-wrap: wrap;
            gap: 12px;
        }
        .brand {
            font-family: 'Berkshire Swash', Georgia, serif;
            font-size: 32px;
            color: #4a6b2c;
            text-decoration: none;
        }
        .nav { display: flex; gap: 10px; flex-wrap: wrap; }
        .pill-btn {
            padding: 9px 18px;
            border-radius: 9999px;
            text-decoration: none;
            font-size: 13px;
            font-weight: 700;
            background: #c83768;
            color: #fff;
            border: none;
            cursor: pointer;
        }
        .pill-btn--olive { background: #4a6b2c; }
        .pill-btn--soft {
            background: #ffe6ef;
            color: #2b2328;
            border: 1px solid #f4c6d7;
        }
        .pill-btn--danger {
            background: rgba(211, 47, 47, 0.12);
            color: #d32f2f;
            border: 1px solid rgba(211, 47, 47, 0.3);
        }
        .container {
            max-width: 1140px;
            margin: 26px auto;
            padding: 0 20px 44px;
            display: flex;
            flex-direction: column;
            gap: 18px;
        }
        .card {
            background: #fff0f5;
            border: 1.5px solid #f4c6d7;
            border-radius: 24px;
            padding: 20px 24px;
            box-shadow: 0 8px 22px rgba(200, 55, 104, 0.12);
        }
        .stats-grid {
            display: grid;
            grid-template-columns: repeat(auto-fit, minmax(170px, 1fr));
            gap: 12px;
        }
        .stat-tile {
            background: #ffe6ef;
            border: 1px solid #f4c6d7;
            border-radius: 18px;
            padding: 14px 16px;
        }
        .stat-tile strong { display: block; font-size: 22px; color: #c83768; margin-top: 4px; }
        table {
            width: 100%;
            border-collapse: collapse;
            margin-top: 12px;
            font-size: 13px;
        }
        th, td {
            text-align: left;
            padding: 10px 12px;
            border-bottom: 1px solid #f4c6d7;
        }
        th { color: #7c5667; font-size: 12px; }
        .role-badge {
            padding: 3px 10px;
            border-radius: 9999px;
            font-size: 11px;
            font-weight: 700;
        }
        .role-ADMIN { background: #4a6b2c; color: #fff; }
        .role-USER { background: #ffe6ef; color: #7c5667; border: 1px solid #f4c6d7; }
        .form-grid {
            display: grid;
            grid-template-columns: repeat(auto-fit, minmax(160px, 1fr));
            gap: 10px;
            margin-top: 12px;
        }
        .input, .textarea {
            width: 100%;
            padding: 9px 14px;
            border-radius: 14px;
            border: 1px solid #f4c6d7;
            background: #fff;
            font-family: inherit;
            font-size: 13px;
        }
    </style>
</head>
<body>
<header class="header">
    <a href="/" class="brand">NutriTrack</a>
    <nav class="nav">
        <a href="/catalog" class="pill-btn pill-btn--soft">📖 Каталог рецептів</a>
        <a href="/about.html" class="pill-btn pill-btn--soft">ℹ️ Про проєкт</a>
        <a href="/" class="pill-btn">← На головну</a>
    </nav>
</header>

<main class="container">
    <% if (forbidden) { %>
        <section class="card" style="text-align: center;">
            <h2 style="color: #d32f2f; margin-top: 0;">⛔ Доступ заборонено (403 Forbidden)</h2>
            <p>Ця сторінка доступна лише користувачам із роллю <strong>ADMIN</strong>.</p>
            <a href="/" class="pill-btn">Повернутися до кабінету</a>
        </section>
    <% } else { %>
        <!-- ЗВЕДЕНА СТАТИСТИКА -->
        <section class="card">
            <h1 style="margin: 0 0 14px 0; font-size: 22px;">🛡️ Панель адміністратора NutriTrack</h1>
            <div class="stats-grid">
                <div class="stat-tile">Користувачів<strong><%= stats.usersCount %></strong></div>
                <div class="stat-tile">Записів харчування<strong><%= stats.mealsCount %></strong></div>
                <div class="stat-tile">Записів води<strong><%= stats.waterLogsCount %></strong></div>
                <div class="stat-tile">Рецептів у БД<strong><%= stats.recipesCount %></strong></div>
                <div class="stat-tile">Власних продуктів<strong><%= stats.customFoodsCount %></strong></div>
            </div>
        </section>

        <!-- КЕРУВАННЯ КОРИСТУВАЧАМИ ТА РОЛЯМИ -->
        <section class="card">
            <div style="display: flex; justify-content: space-between; align-items: center; flex-wrap: wrap; gap: 10px;">
                <h2 style="margin: 0; font-size: 18px;">👥 Користувачі та ролі</h2>
                <form method="GET" action="/admin" style="display: flex; gap: 8px;">
                    <input type="text" name="q" value="<%= query %>" placeholder="Пошук за email або ім'ям..." class="input" />
                    <button type="submit" class="pill-btn">Знайти</button>
                </form>
            </div>

            <div style="overflow-x: auto;">
                <table>
                    <thead>
                    <tr>
                        <th>ID</th>
                        <th>Ім'я</th>
                        <th>Email</th>
                        <th>Активність (прийоми / рецепти)</th>
                        <th>Поточна роль</th>
                        <th>Дія</th>
                    </tr>
                    </thead>
                    <tbody>
                    <% users.forEach((u) => { %>
                        <tr>
                            <td><%= u.id %></td>
                            <td><strong><%= u.name || 'Без імені' %></strong></td>
                            <td><%= u.email %></td>
                            <td><%= u._count.meals %> / <%= u._count.recipes %></td>
                            <td><span class="role-badge role-<%= u.role %>"><%= u.role %></span></td>
                            <td>
                                <% if (u.id === user.id) { %>
                                    <span style="font-size: 12px; color: #7c5667;">Ви (поточний адмін)</span>
                                <% } else { %>
                                    <form method="POST" action="/admin/users/<%= u.id %>/role" style="display: inline;">
                                        <input type="hidden" name="role" value="<%= u.role === 'ADMIN' ? 'USER' : 'ADMIN' %>" />
                                        <button type="submit" class="pill-btn <%= u.role === 'ADMIN' ? 'pill-btn--soft' : 'pill-btn--olive' %>">
                                            <%= u.role === 'ADMIN' ? 'Зробити USER' : 'Надати ADMIN' %>
                                        </button>
                                    </form>
                                <% } %>
                            </td>
                        </tr>
                    <% }) %>
                    </tbody>
                </table>
            </div>
        </section>

        <!-- СТВОРЕННЯ СИСТЕМНОГО РЕЦЕПТУ (userId = null) -->
        <section class="card">
            <h2 style="margin: 0 0 6px 0; font-size: 18px;">🌿 Додати системний рецепт (для всіх користувачів)</h2>
            <form method="POST" action="/admin/recipes">
                <div class="form-grid">
                    <input type="text" name="title" placeholder="Назва страви *" required class="input" />
                    <input type="number" name="prepTime" placeholder="Час (хв)" class="input" />
                    <input type="number" name="calories" placeholder="Ккал / 100г *" required class="input" />
                    <input type="number" step="0.1" name="proteins" placeholder="Білки (г)" class="input" />
                    <input type="number" step="0.1" name="fats" placeholder="Жири (г)" class="input" />
                    <input type="number" step="0.1" name="carbs" placeholder="Вуглеводи (г)" class="input" />
                </div>
                <div style="margin-top: 10px; display: flex; flex-direction: column; gap: 10px;">
                    <input type="text" name="description" placeholder="Короткий опис страви" class="input" />
                    <textarea name="instructions" rows="2" placeholder="Інгредієнти та спосіб приготування" class="textarea"></textarea>
                    <div>
                        <button type="submit" class="pill-btn pill-btn--olive">+ Опублікувати системний рецепт</button>
                    </div>
                </div>
            </form>

            <!-- СПИСОК РЕЦЕПТІВ ДЛЯ МОДЕРАЦІЇ -->
            <div style="overflow-x: auto; margin-top: 16px;">
                <table>
                    <thead>
                    <tr>
                        <th>ID</th>
                        <th>Назва</th>
                        <th>Тип</th>
                        <th>КБЖВ (на 100г)</th>
                        <th>Модерація</th>
                    </tr>
                    </thead>
                    <tbody>
                    <% recipes.forEach((r) => { %>
                        <tr>
                            <td><%= r.id %></td>
                            <td><strong><%= r.title %></strong></td>
                            <td><%= r.userId === null ? '🌿 Системний' : `Автор: ${r.user?.email || r.userId}` %></td>
                            <td><%= r.calories %> ккал (<%= r.proteins %>/<%= r.fats %>/<%= r.carbs %>)</td>
                            <td>
                                <form method="POST" action="/admin/recipes/<%= r.id %>/delete" onsubmit="return confirm('Видалити цей рецепт?');">
                                    <button type="submit" class="pill-btn pill-btn--danger">🗑️ Видалити</button>
                                </form>
                            </td>
                        </tr>
                    <% }) %>
                    </tbody>
                </table>
            </div>
        </section>
    <% } %>
</main>
</body>
</html>